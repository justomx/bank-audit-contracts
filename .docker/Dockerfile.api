# syntax=docker/dockerfile:1.7
# ============================================================================
# Service image, conforming to Justo's platform standard.
#
# Built by Jenkins, not by this repository. Jenkins invokes the build from the
# repository root and passes the version:
#
#     docker build -f .docker/Dockerfile.api --build-arg VERSION=<version> .
#
# Platform-owned base images, in Justo's ECR (arm64):
#   builder  justo-java21-builder           JDK 21 and Maven
#   runner   justo-java21-spring3x-runner   JRE 21; starts the application by reading
#                                           application/<environment>/deploy-properties.json
#
# The runner has no ENTRYPOINT of its own for this service: that is why the jar must
# be flat (maven-shade-plugin, see pom.xml) and deploy-properties.json must name mainClass.
# ============================================================================

# ---------- Build stage ----------
FROM --platform=linux/arm64 849786826922.dkr.ecr.us-east-1.amazonaws.com/justo-java21-builder:arm64 AS builder

ARG VERSION
WORKDIR /app

COPY . .

# Sets the artifact version assigned by the pipeline.
RUN mvn -q versions:set -DnewVersion=${VERSION} -DgenerateBackupPoms=false \
    -Dorg.slf4j.simpleLogger.log.org.apache.maven.cli.transfer.Slf4jMavenTransferListener=warn

# Tests run in the pipeline, not here: repeating them here lengthens the build without adding signal.
RUN mvn -q package -Dmaven.test.skip=true \
    -Dorg.slf4j.simpleLogger.log.org.apache.maven.cli.transfer.Slf4jMavenTransferListener=warn

# ---------- Runtime stage ----------
FROM --platform=linux/arm64 849786826922.dkr.ecr.us-east-1.amazonaws.com/justo-java21-spring3x-runner:arm64 AS runner

ARG VERSION

# Per-environment configuration: application.yml, logback.xml, and deploy-properties.json.
COPY conf application/

# INIT: scripts/init-repo.sh replaces the artifact name.
COPY --from=builder /app/target/bank-template-vertical-bank-${VERSION}.jar application/bank-template-vertical-bank-${VERSION}.jar
